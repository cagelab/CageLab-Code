        <mxCell id="lL5VCXaNQY335Jlp-qxD-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Subject&lt;div&gt;Display&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="251" y="30" as="geometry" />
        </mxCell>
        <mxCell id="RdGRmkzCyzK2RX1CwvWr-34" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=left;labelBorderColor=none;textShadow=0;convertToSvg=1;svgWhiteSpace=wrap;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;CageLab Communication Architecture&lt;/h1&gt;&lt;p&gt;CageLab is a remote cognitive experiment box, combining MATLAB driven&amp;nbsp; touchscreen / joystick-based cognitive tasks, a camera, reward system. To scale CageLab up we need a &lt;b&gt;robust&lt;/b&gt; communication protocol so a single control PC can manage multiple CageLab boxes.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;b&gt;cogmoteGO&lt;/b&gt; - task agnostic middleware, can proxy experiment commands from a remote control PC to experiment code and also broadcast task data back to multiple remote observers.&lt;/p&gt;&lt;p&gt;&lt;b&gt;CageLab GUI&lt;/b&gt; - control MATLAB services running on multiple remote CageLab boxes. Send control commands to start and stop tasks.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Cogmote&lt;/b&gt; - view the camera and display of multiple CageLab boxes and also subscribe to their data streams and plot task performance.&lt;/p&gt;&lt;p&gt;&lt;b&gt;theConductor&lt;/b&gt; - MATLAB-based remote experiement runner service (systemd service). Commands received via cogmoteGO.&lt;/p&gt;&lt;p&gt;&lt;b&gt;SSH&lt;/b&gt; - universal method to securely control a remote system, run OS commands, update software etc. Nomachine can be used as a visual remote desktop.&lt;/p&gt;&lt;p&gt;&lt;b&gt;ALYX + MINIO&lt;/b&gt; - Neuroscience metadata database (ALYX) to record experiment sessions and link to data files saved on a data store (MINIO).&lt;/p&gt;" vertex="1">
          <mxGeometry height="372" width="464" x="356" y="188" as="geometry" />
        </mxCell>
      </root>
