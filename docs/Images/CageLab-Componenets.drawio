        <mxCell id="lL5VCXaNQY335Jlp-qxD-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;rotation=270;fontStyle=1" value="VPN" vertex="1">
